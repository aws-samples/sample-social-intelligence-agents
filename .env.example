# Required -- AgentCore Runtime ARN from CDK output (RuntimeArn)
AGENTCORE_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/social_intel-XXXXXXXXXX

# AWS region where the stack is deployed.
# AWS_REGION wins if both are set; either falls back to us-east-1.
AWS_DEFAULT_REGION=us-east-1
# AWS_REGION=us-east-1

# AWS CLI profile (optional -- falls back to default credentials)
# AWS_PROFILE=default

# DynamoDB table name (default: social-intel-leads, matches CDK stack)
# LEADS_TABLE_NAME=social-intel-leads

# Runtime application log group from CDK output; used by scripts/benchmark.py
# AGENTCORE_EVENT_LOG_GROUP=/aws/bedrock-agentcore/social-intelligence/application

# Email qualification policy (defaults shown)
# EMAIL_SCORE_THRESHOLD=60
# MIN_INDEPENDENT_SOURCES=2
# MAX_LEADS_PER_RUN=3

# Compliance footer. Boolean vars accept true/1/yes; any other value, including
# "false", leaves the flag off. UNSUBSCRIBE_URL replaces the placeholder link that
# the footer would otherwise render, so set it whenever the footer is enabled.
# COMPLIANCE_FOOTER_REQUIRED=true
# UNSUBSCRIBE_URL=https://www.example.com/unsubscribe

# Secrets Manager cache TTL in the tools Lambda, in seconds (default 600). Lower it
# to shorten how long a rotated third-party credential stays valid in a warm Lambda.
# SECRET_CACHE_TTL_SECONDS=600

# Token pricing for scripts/benchmark.py cost estimates, in USD per million
# tokens. Unset means cost reporting is skipped rather than guessed.
# BENCHMARK_INPUT_COST_PER_MILLION=3.00
# BENCHMARK_OUTPUT_COST_PER_MILLION=15.00

# scripts/eval_quality.py knobs (defaults shown)
# EVAL_PATTERN must be one of: graph, swarm, both
# EVAL_PATTERN=graph
# EVAL_CONCURRENCY=5
# EVAL_GROUNDING_MIN=5
# EVAL_POLL_DELAY_SECONDS=15
# EVAL_POLL_TIMEOUT_SECONDS=1260
# Judge model for eval scoring. The default global. profile resolves in any
# supported Region; override to pin a Region-scoped inference profile.
# JUDGE_MODEL_ID=global.anthropic.claude-sonnet-4-6
